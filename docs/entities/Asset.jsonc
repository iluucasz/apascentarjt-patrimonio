{
  "name": "Asset",
  "type": "object",
  "properties": {
    "asset_number": {
      "type": "string",
      "title": "Número patrimonial"
    },
    "name": {
      "type": "string",
      "title": "Nome do patrimônio"
    },
    "description": {
      "type": "string",
      "title": "Descrição"
    },
    "category_id": {
      "type": "string",
      "title": "Categoria (ID)"
    },
    "category_name": {
      "type": "string",
      "title": "Nome da categoria"
    },
    "brand": {
      "type": "string",
      "title": "Marca"
    },
    "model": {
      "type": "string",
      "title": "Modelo"
    },
    "serial_number": {
      "type": "string",
      "title": "Número de série"
    },
    "location_id": {
      "type": "string",
      "title": "Unidade (ID)"
    },
    "location_name": {
      "type": "string",
      "title": "Nome do local"
    },
    "responsible_person": {
      "type": "string",
      "title": "Responsável"
    },
    "acquisition_date": {
      "type": "string",
      "format": "date",
      "title": "Data de aquisição"
    },
    "acquisition_value": {
      "type": "number",
      "title": "Valor de aquisição"
    },
    "supplier": {
      "type": "string",
      "title": "Fornecedor"
    },
    "invoice_number": {
      "type": "string",
      "title": "Número da nota fiscal"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "maintenance",
        "loaned",
        "storage",
        "disposed",
        "lost"
      ],
      "default": "active",
      "title": "Status"
    },
    "condition": {
      "type": "string",
      "enum": [
        "new",
        "excellent",
        "good",
        "fair",
        "poor",
        "damaged"
      ],
      "default": "good",
      "title": "Estado de conservação"
    },
    "notes": {
      "type": "string",
      "title": "Observações"
    },
    "photo_url": {
      "type": "string",
      "format": "file",
      "title": "Foto"
    },
    "archived_at": {
      "type": "string",
      "format": "date-time",
      "title": "Arquivado em"
    },
    "disposed_reason": {
      "type": "string",
      "enum": [
        "descarte",
        "venda",
        "doacao",
        "perda",
        "roubo",
        "outro"
      ],
      "title": "Motivo da baixa"
    },
    "disposed_notes": {
      "type": "string",
      "title": "Observação da baixa"
    },
    "variant": {
      "type": "string",
      "title": "Variante"
    },
    "batch_id": {
      "type": "string",
      "title": "Lote (ID)"
    },
    "location_detail": {
      "type": "string",
      "title": "Local",
      "description": "Onde o item fica dentro da unidade (ex.: Salão, armário 2). A unidade é location_id/location_name."
    }
  },
  "required": [
    "name"
  ]
}