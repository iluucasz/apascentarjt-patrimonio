{
  "name": "Location",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Nome"
    },
    "description": {
      "type": "string",
      "title": "Descrição"
    },
    "parent_location_id": {
      "type": "string",
      "title": "Local pai (ID)"
    },
    "parent_location_name": {
      "type": "string",
      "title": "Nome do local pai"
    },
    "active": {
      "type": "boolean",
      "title": "Ativo",
      "default": true
    },
    "is_main": {
      "type": "boolean",
      "title": "Filial principal (visão geral de todas as filiais)",
      "default": false
    }
  },
  "required": [
    "name"
  ]
}